---
import raw from './butterfly.svg?raw';
const { size = 40, class: cls = '' } = Astro.props;
const svg = raw
  .replace(/<\?xml[^>]*>/, '')
  .replace(/width="\d+" height="\d+"/, `width="${size}" height="${Math.round(size * 1180 / 1820)}" class="bfly ${cls}" aria-hidden="true" focusable="false"`);
---
<Fragment set:html={svg} />
